{
  "name": "bento-kumiko-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check.mjs",
    "cloudflare:dev": "pnpm build && wrangler dev",
    "cloudflare:dry-run": "pnpm build && WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/logs/wrangler.log wrangler deploy --dry-run",
    "cloudflare:deploy": "REQUIRE_PRODUCTION_READY=1 pnpm build && wrangler deploy",
    "preview": "node scripts/serve.mjs",
    "test": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "4.154.0"
  }
}
